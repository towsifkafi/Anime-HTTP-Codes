<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ code }} {{ name }}</title>
    <style>{{ cssContent | safe }}</style>
</head>
<body>
    <div class="container">
        <div class="image-box">
            <img src="{{ image }}" alt="{{ name }}" />
        </div>
        <h1>{{ code }}</h1>
        <h2>{{ name }}</h2>
    </div>
</body>
</html>
