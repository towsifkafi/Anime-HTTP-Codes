<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anime HTTP Codes</title>
    <style>{{ cssContent | safe }}</style>
</head>
<body class="index-page">
    <header class="index-header">
        <div class="info">
            <h1>Anime HTTP Codes</h1>
            <p>HTTP status pages with anime images — pick a code to preview.</p>
        </div>
            <a href="https://github.com/towsifkafi/Anime-HTTP-Codes" target="_blank" rel="noopener noreferrer" style="color: white; display: inline-block; transition: opacity 0.2s;" onmouseover="this.style.opacity=0.7" onmouseout="this.style.opacity=1">
                <svg height="32" viewBox="0 0 16 16" width="32" style="fill: currentColor;">
                    <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.46-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
                </svg>
            </a>
    </header>

    <main class="index-grid">
        {% for item in codes %}
        <a href="{{ item.code }}.html" class="code-card">
            <div class="code-card__image">
                <img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy" />
            </div>
            <div class="code-card__info">
                <span class="code-card__code">{{ item.code }}</span>
                <span class="code-card__name">{{ item.name }}</span>
            </div>
        </a>
        {% endfor %}
    </main>
</body>
</html>
